{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; frame-src 'self' molly-image://localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:",
      "devCsp": "default-src 'self' http://localhost:24320; frame-src 'self' molly-image://localhost; img-src 'self' http://localhost:24320 asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' http://localhost:24320; connect-src 'self' ipc: http://ipc.localhost http://localhost:24320 ws://localhost:24321 https:"
    },
    "windows": [
      {
        "label": "console",
        "create": false,
        "title": "MollyCloud",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "dragDropEnabled": false,
        "center": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      },
      {
        "label": "main",
        "create": false,
        "title": "MollyCloud 助手",
        "url": "overlay.html",
        "width": 700,
        "height": 700,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/macos/32x32.png",
      "icons/macos/128x128.png",
      "icons/macos/128x128@2x.png",
      "icons/macos/icon.icns"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.macos.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
